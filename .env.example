# PartFlow development environment configuration.
# Copy this file to .env and adjust values as needed.
# The real .env is git-ignored; never commit real secrets.

# PostgreSQL development-only credentials (consumed by Docker Compose).
POSTGRES_USER=partflow_user
POSTGRES_PASSWORD=partflow_dev_password
POSTGRES_DB=partflow

# Backend database connection for running the backend outside Docker.
# Inside Docker Compose, DATABASE_URL is derived from the values above and
# points at the db service instead of localhost.
DATABASE_URL=postgresql+psycopg://partflow_user:partflow_dev_password@localhost:5432/partflow

# Vite dev-server proxy target for /api requests when running the frontend
# outside Docker. Docker Compose sets this to http://backend:8000.
BACKEND_PROXY_TARGET=http://localhost:8000
