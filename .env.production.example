# PartFlow production stack configuration (compose.production.yaml).
# Copy to .env.production (git-ignored), fill every empty value, chmod 600.
# Secrets are never set here: they are files in PARTFLOW_SECRETS_DIR.

# Release tag of the RUNNING images (DEPLOYMENT §10), e.g. v1.0.0-rc.1.
# A candidate tag is passed in the shell for build/rehearsal/migrate and written here only at the
# switch (DEPLOYMENT §3.1 release sequence); never rebuild an existing tag (rollback keeps the old images).
PARTFLOW_RELEASE=

# Absolute path of the secrets directory, outside the repository checkout; production only (never staging's).
# Directory mode 0700 (deployment administrator); each file mode 0444.
# Files: postgres_password (exactly one line; trailing line breaks are ignored). It seeds a NEW database
# volume only: to change it later, ALTER ROLE ... PASSWORD first, then replace the file.
PARTFLOW_SECRETS_DIR=

# Factory calendar (IANA zone, e.g. America/Los_Angeles); same value as staging (DEPLOYMENT §6).
# It dates Work Order completions and the default received date of new (and imported) Work Orders.
PARTFLOW_SITE_TIMEZONE=

# Loopback port that the platform TLS proxy connects to (web is bound to 127.0.0.1 only).
PARTFLOW_HTTP_PORT=18080

# PostgreSQL bootstrap (owner) role and database. Until P16-S4 the backend also uses this role.
POSTGRES_USER=partflow_owner
POSTGRES_DB=partflow

# Backend worker processes (OD-16-03). Keep 2 here; first-run setup runs one `up` with
# PARTFLOW_BACKEND_WORKERS=1 set in the shell (DEPLOYMENT §3.1).
PARTFLOW_BACKEND_WORKERS=2

# Subnet of the edge network (web + backend); choose one unused on the host and the LAN.
PARTFLOW_EDGE_SUBNET=172.30.250.0/24

# Leave empty: web trusts forwarded headers only from its edge gateway, detected at start.
# Set one IPv4 address only if the P16-S7 host check shows the platform proxy arrives from another address.
PARTFLOW_TRUSTED_PROXY=

# Resource limits (measure on the pilot host, SYNOLOGY_NAS §9).
PARTFLOW_DB_MEMORY=1g
PARTFLOW_DB_CPUS=1.0
PARTFLOW_BACKEND_MEMORY=1g
PARTFLOW_BACKEND_CPUS=2.0
PARTFLOW_WEB_MEMORY=128m
PARTFLOW_WEB_CPUS=0.5
PARTFLOW_OPS_MEMORY=512m
PARTFLOW_OPS_CPUS=1.0
