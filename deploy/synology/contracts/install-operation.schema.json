{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deployment Admin install operation v1 (PF-A2.1)",
  "description": "Frozen InstallPlan and InstallJournal of one install operation under <root>/install-operations/<operation-id>/. Strict UTF-8 JSON; duplicate keys, non-finite numbers and unknown keys are rejected; booleans are not integers.",
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_operation_required",
        "bindings",
        "candidate",
        "config_baseline",
        "created",
        "init_documents",
        "install_contract",
        "instance",
        "kind",
        "launcher",
        "legacy",
        "notes",
        "operation_id",
        "root",
        "running_release",
        "schema_version",
        "selected_existing_release",
        "verify_baseline"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^inst-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
        },
        "kind": {
          "enum": [
            "init",
            "register",
            "migrate-legacy",
            "control"
          ]
        },
        "created": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "root": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "install_contract": {
          "type": "integer",
          "minimum": 1
        },
        "running_release": {
          "description": "null or release-id"
        },
        "candidate": {
          "description": "null or $defs.candidate"
        },
        "selected_existing_release": {
          "type": "boolean"
        },
        "init_documents": {
          "description": "null or $defs.init_documents"
        },
        "instance": {
          "description": "null or $defs.instance"
        },
        "legacy": {
          "description": "null or $defs.legacy"
        },
        "launcher": {
          "description": "null or $defs.launcher"
        },
        "bindings": {
          "type": "array",
          "description": "items $defs.binding"
        },
        "config_baseline": {
          "type": "array",
          "description": "items $defs.config_baseline"
        },
        "verify_baseline": {
          "type": "array",
          "description": "items $defs.verify_baseline"
        },
        "app_operation_required": {
          "enum": [
            "none",
            "update"
          ]
        },
        "notes": {
          "type": "array",
          "description": "items $defs.note"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_files",
        "checkpoint",
        "files",
        "inventory_sha256",
        "release_id",
        "source_root",
        "version"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "files": {
          "type": "object",
          "description": "map sha256"
        },
        "bootstrap_files": {
          "type": "object",
          "description": "map sha256"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "checkpoint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_root": {
          "description": "null or path"
        }
      }
    },
    "init_documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "sha256",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "revision",
            "sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved_environment",
        "compose_project",
        "daemon",
        "instance_id",
        "paths",
        "slug"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
        },
        "compose_project": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
        },
        "approved_environment": {
          "enum": [
            "staging"
          ]
        },
        "daemon": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "engine_id"
          ],
          "properties": {
            "endpoint": {
              "type": "string",
              "pattern": "^unix:///[^\\u0000-\\u001f\\u007f]+$"
            },
            "engine_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backups",
            "configuration",
            "recovery",
            "workspace"
          ],
          "properties": {
            "workspace": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
            },
            "configuration": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
            },
            "backups": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
            },
            "recovery": {
              "type": "string",
              "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
            }
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_dir",
        "files",
        "home",
        "lock_created",
        "lock_path",
        "state_dir",
        "state_report"
      ],
      "properties": {
        "home": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "control_dir": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "state_dir": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "lock_path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "lock_created": {
          "type": "boolean"
        },
        "files": {
          "type": "array",
          "description": "items $defs.legacy_file"
        },
        "state_report": {
          "type": "array",
          "description": "items $defs.state_file"
        }
      }
    },
    "legacy_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gid",
        "mode",
        "role",
        "sha256",
        "size",
        "source",
        "staged",
        "target"
      ],
      "properties": {
        "role": {
          "enum": [
            "env",
            "admin-config"
          ]
        },
        "source": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "target": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "staged": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "minimum": 0
        },
        "gid": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "state_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "after_text",
        "before_kind",
        "before_sha256",
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "before_kind": {
          "enum": [
            "absent",
            "legacy",
            "installed",
            "foreign"
          ]
        },
        "before_sha256": {
          "description": "null or sha256"
        },
        "after_text": {
          "description": "null or string"
        },
        "action": {
          "enum": [
            "create",
            "leave"
          ]
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "after_sha256",
        "after_text",
        "before_sha256",
        "before_text",
        "effect_id",
        "target",
        "type"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "bootstrap-conf",
            "tools-conf",
            "record",
            "wrapper"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "before_text": {
          "description": "null or string"
        },
        "before_sha256": {
          "description": "null or sha256"
        },
        "after_text": {
          "type": "string"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "config_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config",
        "env",
        "instance_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "config": {
          "enum": [
            "ok",
            "missing",
            "invalid"
          ]
        },
        "env": {
          "enum": [
            "ok",
            "missing",
            "invalid"
          ]
        }
      }
    },
    "verify_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "instance_id",
        "path"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "detail"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effects",
        "kind",
        "last_error",
        "next",
        "operation_id",
        "phase",
        "plan_sha256",
        "result",
        "schema_version",
        "sequence",
        "started",
        "updated"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation_id": {
          "type": "string",
          "pattern": "^inst-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
        },
        "kind": {
          "enum": [
            "init",
            "register",
            "migrate-legacy",
            "control"
          ]
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "phase": {
          "enum": [
            "planned",
            "prepared",
            "validated",
            "switching",
            "verifying",
            "rolling_back",
            "abandoning",
            "needs_operator",
            "completed",
            "cancelled",
            "rolled_back",
            "abandoned"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "started": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "updated": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "effects": {
          "type": "array",
          "description": "items $defs.effect"
        },
        "result": {
          "description": "null or $defs.result"
        },
        "last_error": {
          "description": "null or string"
        },
        "next": {
          "type": "array",
          "description": "items string"
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "effect_id",
        "observed",
        "state",
        "target_identity",
        "type"
      ],
      "properties": {
        "effect_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "intended",
            "complete",
            "reversed"
          ]
        },
        "observed": {
          "enum": [
            null,
            "not_started",
            "complete",
            "partial",
            "unknown"
          ]
        },
        "target_identity": {
          "description": "null or $defs.target_identity"
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    },
    "target_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "st_dev",
        "st_ino"
      ],
      "properties": {
        "st_dev": {
          "type": "integer",
          "minimum": 0
        },
        "st_ino": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bootstrap_conf_sha256",
        "instance_id",
        "launcher",
        "records",
        "release_id"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "bootstrap_conf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "records": {
          "type": "object",
          "description": "map sha256"
        },
        "instance_id": {
          "description": "null or string"
        },
        "launcher": {
          "description": "null or $defs.result_launcher"
        }
      }
    },
    "result_launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\u0000-\\u001f\\u007f]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
