# NAS staging runtime configuration template.
# The installed root-owned controller creates <home>/config/.env from this file.
# POSTGRES_PASSWORD is generated automatically. Runtime .env lives outside repo/.
POSTGRES_USER=partflow_staging
POSTGRES_PASSWORD=
POSTGRES_DB=partflow_staging

# Factory calendar, not the browser timezone.
SITE_TIMEZONE=America/Los_Angeles

# Direct LAN: set the NAS's reserved LAN IP.
# DSM Reverse Proxy: keep 127.0.0.1.
PARTFLOW_BIND_IP=127.0.0.1
PARTFLOW_HTTP_PORT=5173

# Exact internal hostname for DSM Reverse Proxy; localhost for direct LAN access.
PARTFLOW_ALLOWED_HOST=localhost
