# NAS staging only. Copy this file to .env beside compose.nas.yaml.
# Never commit .env or share its contents.
POSTGRES_USER=partflow_staging
POSTGRES_PASSWORD=
POSTGRES_DB=partflow_staging

# Factory calendar, not the browser timezone.
SITE_TIMEZONE=America/Los_Angeles

# Safe initial default. For direct LAN testing, replace with the NAS's
# reserved LAN IP. For DSM Reverse Proxy, keep 127.0.0.1.
PARTFLOW_BIND_IP=127.0.0.1
PARTFLOW_HTTP_PORT=5173

# Use one exact internal hostname you control when enabling Reverse Proxy.
# IP access needs no additional hostname.
PARTFLOW_ALLOWED_HOST=localhost
